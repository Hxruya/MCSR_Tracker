# Copy to .env and fill in. .env is git-ignored.
FLASK_SECRET_KEY=change-me-to-a-long-random-string

MARIADB_HOST=localhost
MARIADB_PORT=3306
# The two accounts from setup/sql/accounts.sql (README step 3): the app's (data only) and the schema owner's,
# which init_db, restore_data and the tests' setup use.
MARIADB_USER=mcsr_app
MARIADB_PASSWORD=
MARIADB_ADMIN_USER=mcsr_admin
MARIADB_ADMIN_PASSWORD=
MARIADB_DATABASE=mcsr
MARIADB_TEST_DATABASE=mcsr_test

MONGO_URI=mongodb://localhost:27017
# Optional admin connection (setup/mongo_accounts.py), e.g. mongodb://mcsr_admin:<password>@localhost:27017/?authSource=admin
MONGO_ADMIN_URI=
MONGO_DB=mcsr
MONGO_TEST_DB=mcsr_test

MCSR_API_BASE=https://api.mcsrranked.com

# 0 hides the "Behind this page" query panel
QUERY_PANEL=1
